# =========================================
# WORKTIME PRO — Environment Variables
# =========================================
# Copy to .env and fill in real values.
# .env is git-ignored.

# ---------- General ----------
ENVIRONMENT=development              # development | staging | production
DEBUG=true
PROJECT_NAME=WorktimePro
DOMAIN=worktimepro.uz                # production domain (used by Traefik)
ACME_EMAIL=admin@worktimepro.uz      # Let's Encrypt email
TZ=Asia/Tashkent

# ---------- Backend / API ----------
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Default language
DEFAULT_LANGUAGE=uz                  # uz | ru | en

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=worktimepro
POSTGRES_USER=worktimepro
POSTGRES_PASSWORD=change-me-strong-password
# Constructed from above (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://worktimepro:change-me-strong-password@postgres:5432/worktimepro

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery (uses Redis)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- MinIO (S3-compat) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://files.worktimepro.uz
MINIO_BUCKET=worktimepro
MINIO_SECURE=false

# ---------- Initial Owner (seed) ----------
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_EMAIL=owner@worktimepro.uz
INITIAL_OWNER_PASSWORD=ChangeMeOwner123!

# ---------- Sentry (optional) ----------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@worktimepro.uz
SMTP_TLS=true

# ---------- FCM Push (mobile) ----------
FCM_SERVER_KEY=

# ---------- Admin Web (Vite) ----------
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ---------- Client Web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
