# =========================================
# Hr-Profi — PRODUCTION env
# =========================================
# Serverga clone qilgandan keyin: cp .env.production.example .env va
# `change-me-...` qiymatlarini real qiymatlarga o'zgartiring.
# .env git'ga commit qilinmaydi.

# ---------- General ----------
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=Hr-Profi
DOMAIN=hr-profi.uz
ACME_EMAIL=admin@hr-profi.uz
TZ=Asia/Tashkent

# ---------- Backend / API ----------
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-at-least-64-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
ALGORITHM=HS256
BCRYPT_ROUNDS=12

# 3 ta web origin — admin/landing/PWA
CORS_ORIGINS=https://hr-profi.uz,https://www.hr-profi.uz,https://admin.hr-profi.uz,https://my.hr-profi.uz

DEFAULT_LANGUAGE=uz

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hrprofi
POSTGRES_USER=hrprofi
POSTGRES_PASSWORD=change-me-strong-postgres-password
DATABASE_URL=postgresql+asyncpg://hrprofi:change-me-strong-postgres-password@postgres:5432/hrprofi

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- MinIO (S3) ----------
MINIO_ROOT_USER=hrprofi
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=hrprofi
MINIO_PUBLIC_HOST=files.hr-profi.uz
MINIO_USE_SSL=false

# ---------- Email (SMTP) ----------
# Bo'sh qoldiring agar SMTP konfiguratsiyangiz yo'q bo'lsa.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hr-profi.uz

# ---------- Web Push (VAPID) ----------
# Bo'lmasa generate qiling: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.private_key.private_numbers().private_value); print(v.public_key.public_numbers())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@hr-profi.uz
