{
  "cli": {
    "version": ">= 11.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.worktimepro.uz/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.worktimepro.uz/ws"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.worktimepro.uz/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.worktimepro.uz/ws"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.worktimepro.uz/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.worktimepro.uz/ws"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {}
  }
}
